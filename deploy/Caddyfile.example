# Caddy config for saorsa.space (use this one only if the server already runs Caddy).
# Caddy gets the HTTPS certificate automatically.
# Add this block to /etc/caddy/Caddyfile, then:  sudo systemctl reload caddy

saorsa.space, www.saorsa.space {
	# Password protection while Saorsa is being built.
	# Make the hash with:  caddy hash-password
	basic_auth {
		saorsa $2a$14$REPLACE_WITH_HASH
	}

	root * /srv/saorsa/web
	encode zstd gzip
	file_server

	# PocketBase API + admin, once it's running on port 8090
	handle_path /pb/* {
		reverse_proxy 127.0.0.1:8090
	}

	header {
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
	}
	@media path /media/*
	header @media Cache-Control "public, max-age=2592000"
}
